+/*
+ * netOS has neither fork nor a temp directory: the editor feeds filter
+ * input from memory itself, whenever the filter has no output ready.
+ */
+static char	*fibuf;
+static size_t	filen, fipos;
+static int	fifd = -1;
+
+static void
+fifill(void)
+{
+	char savelb[LBSIZE];
+	size_t n, sz = 0;
+	line *a;
+
+	filen = fipos = 0;
+	if (fixedzero)
+		return;
+	CP(savelb, linebuf);
+	for (a = addr1; a <= addr2; a++) {
+		getline(*a);
+		n = strlen(linebuf) + 1;
+		if (filen + n > sz) {
+			sz = 2 * (filen + n);
+			if ((fibuf = realloc(fibuf, sz)) == NULL)
+				error(" Out of memory");
+		}
+		memcpy(fibuf + filen, linebuf, n);
+		filen += n;
+		fibuf[filen - 1] = '\n';
+	}
+	CP(linebuf, savelb);
+}
+
+/* feed the filter until fd has output to read, or all of it if fd < 0 */
+void
+fifeed(int fd)
+{
+	fd_set r, w;
+	ssize_t k;
+	shand op;
+
+	if (fifd < 0)
+		return;
+	op = signal(SIGPIPE, SIG_IGN);
+	while (fipos < filen) {
+		FD_ZERO(&r);
+		FD_ZERO(&w);
+		if (fd >= 0)
+			FD_SET(fd, &r);
+		FD_SET(fifd, &w);
+		if (select((fd > fifd ? fd : fifd) + 1, &r, &w, NULL, NULL) < 0)
+			break;
+		if (fd >= 0 && FD_ISSET(fd, &r)) {
+			signal(SIGPIPE, op);
+			return;
+		}
+		if (!FD_ISSET(fifd, &w))
+			continue;
+		/* small writes, so a blocking one cannot wait on the reader */
+		if ((k = write(fifd, fibuf + fipos, filen - fipos < 256 ?
+				filen - fipos : 256)) < 0)
+			break;
+		fipos += k;
+	}
+	signal(SIGPIPE, op);
+	close(fifd);
+	fifd = -1;
+}
+#endif
 
